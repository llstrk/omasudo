#!/bin/bash
# Omasudo setup.
#   omasudo status        rule, reviewers and setup state
#   omasudo setup         install the polkit rule and choose reviewers (needs a terminal)
#   omasudo setup --auto  the dialog's call when it loads: ask in a floating
#                         terminal if the rule or the reviewer choice is missing
#   omasudo reviewer      choose which agents review requests, in order
#   omasudo agents        coding agents found on this machine
#   omasudo uninstall     remove the polkit rule
#   omasudo update [--check|--off|--on]  new versions (see bin/update.py)
set -uo pipefail

here=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/omasudo
declined=$state_dir/setup-declined
# Held while a setup prompt is open, so a second load of the dialog (enable,
# then a shell restart) does not open another one.
lock=$state_dir/setup.lock

# OMASUDO_SYSTEM_ROOT prefixes the system paths status reads; the feature
# tests point it at a throwaway folder. Unset, they are the real ones.
sysroot=${OMASUDO_SYSTEM_ROOT:-}
RULE=$sysroot/etc/polkit-1/rules.d/00-subject-note.rules
HELPER=$sysroot/usr/local/lib/polkit-subject-note
DROPIN=$sysroot/etc/systemd/system/polkit.service.d/subject-note.conf
UNINSTALLER=$sysroot/usr/local/lib/omasudo/uninstall.sh
# rules.d is readable only by root and polkitd, so install.sh records the
# installed rule's hash here for status to compare.
RULE_SUM=$sysroot/usr/local/lib/omasudo/rule.sha256
NOTES=$sysroot/run/polkit-subject

rule_state() {
  if [[ ! -e $HELPER && ! -e $DROPIN && ! -e $UNINSTALLER ]]; then
    echo missing
  elif [[ $(cat "$RULE_SUM" 2>/dev/null) == "$(sha256sum < "$here/system/00-subject-note.rules" | cut -d' ' -f1)" ]] \
    && cmp -s "$here/system/polkit-subject-note" "$HELPER" \
    && cmp -s "$here/system/subject-note.conf" "$DROPIN" \
    && cmp -s "$here/system/uninstall.sh" "$UNINSTALLER" \
    && [[ -d $NOTES ]]; then
    echo installed
  else
    echo outdated
  fi
}

agents() {
  python3 -I "$here/bin/agents.py" "$@"
}

reviewers_state() {
  if ! agents configured; then
    echo "not chosen"
  else
    local r
    r=$(agents get | paste -sd, -)
    echo "${r:-none}"
  fi
}

# setup [--prompted]: --prompted (from setup --auto) skips a rule step the
# user declined; run by hand, setup offers the rule again.
setup() {
  mkdir -p "$state_dir"
  exec 9>"$lock"
  if ! flock -n 9; then
    echo "Setup is already open in another window."
    return 0
  fi
  local rule=$(rule_state)
  if [[ $rule == installed ]]; then
    [[ ${1:-} == --prompted ]] || echo "The polkit rule is installed."
  elif [[ ${1:-} == --prompted && -e $declined ]]; then
    :
  else
    rule_step "$rule" || return 1
  fi
  echo
  if ! agents configured; then
    agents pick
  elif [[ ${1:-} != --prompted ]]; then
    echo "Reviews: $(reviewers_state | sed 's/,/ → /g'). Change with: $here/bin/omasudo reviewer"
  fi
}

rule_step() {
  local rule=$1
  local title="Finish setting up Omasudo"
  [[ $rule == outdated ]] && title="Update Omasudo's polkit rule"

  local body=(
    "To show which program asked for root, including systemctl and other"
    "D-Bus requests (not just pkexec), Omasudo installs a polkit rule:"
    ""
    "  $RULE"
    "  $HELPER"
    "  $DROPIN"
    "  $UNINSTALLER (and the rule's hash next to it)"
    ""
    "It notes the requesting PID per action in /run/polkit-subject (tmpfs),"
    "never command lines, and makes no authorization decision."
    "polkitd restarts once; the dialog reconnects by itself."
  )
  gum style --border rounded --padding "1 2" --width 78 "$title" "" "${body[@]}"
  echo

  local choice
  choice=$(gum choose "Set it up (asks for your password)" "Not now" "Don't ask again") || choice="Not now"
  case $choice in
    Set*)
      if sudo "$here/system/install.sh"; then
        rm -f "$declined"
        echo
        echo "Done. Requests now show the requesting command, for D-Bus callers too."
      else
        echo "Setup failed; nothing else was changed. Retry with: $here/bin/omasudo setup" >&2
        return 1
      fi
      ;;
    Don*)
      mkdir -p "$state_dir" && : > "$declined"
      echo "Won't ask again. To set up later, run: $here/bin/omasudo setup"
      ;;
    *)
      echo "Asking again next time the shell starts."
      ;;
  esac
}

case ${1:-status} in
  status)
    echo "rule=$(rule_state)"
    echo "reviewers=$(reviewers_state)"
    echo "declined=$([[ -e $declined ]] && echo yes || echo no)"
    ;;
  setup)
    if [[ ${2:-} == --auto ]]; then
      rule_done=no
      [[ $(rule_state) == installed || -e $declined ]] && rule_done=yes
      [[ $rule_done == yes ]] && agents configured && exit 0
      mkdir -p "$state_dir"
      flock -n "$lock" true || exit 0  # a prompt is already open
      exec omarchy-launch-floating-terminal-with-presentation "$(printf %q "$here/bin/omasudo") setup --prompted"
    fi
    setup "${2:-}"
    ;;
  reviewer)
    agents pick
    ;;
  agents)
    agents list
    ;;
  update)
    shift
    exec python3 -I "$here/bin/update.py" "$@"
    ;;
  uninstall)
    if [[ -x $UNINSTALLER ]]; then sudo "$UNINSTALLER"; else sudo "$here/system/uninstall.sh"; fi
    ;;
  *)
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
    ;;
esac
